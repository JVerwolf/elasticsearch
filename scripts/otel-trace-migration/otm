#!/usr/bin/env bash
# otm — OTel Trace Migration scanner shell wrapper
# Activates the virtual environment and delegates to otm.py.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$SCRIPT_DIR/.venv"
PYTHON="${PYTHON:-python3}"
if [ ! -d "$VENV" ]; then
  echo "Setting up virtual environment..."
  "$PYTHON" -m venv "$VENV"
  "$VENV/bin/pip" install --quiet -r "$SCRIPT_DIR/requirements.txt"
fi
exec "$VENV/bin/python3" "$SCRIPT_DIR/otm.py" "$@"
